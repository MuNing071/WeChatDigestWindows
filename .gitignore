# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sensitive data (密钥文件不上传)
*.json
!.gitkeep

# Large binary files
*.db
*.exe
*.dll

# OS
.DS_Store
Thumbs.db

# Go build outputs
wetrace-bin/wetrace/*.exe
wetrace-bin/*.dat

# Decrypted data
output/decrypted/
wetrace-bin/wetrace/data/
